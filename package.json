{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "VITE_BASE_PATH=/Estetica-Gestion/ vite build",
    "build:singlefile": "VITE_SINGLE_FILE=1 vite build",
    "preview": "vite preview",
    "preview:pages": "VITE_BASE_PATH=/Estetica-Gestion/ vite build && vite preview --base /Estetica-Gestion/",
    "build:domain": "VITE_BASE_PATH=/ vite build",
    "preview:domain": "VITE_BASE_PATH=/ vite build && vite preview --base /",
    "verify:domain": "node scripts/verify-domain-build.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router-dom": "^7.14.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  }
}
